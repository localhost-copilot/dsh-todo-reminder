{
  "name": "@localhost-copilot/dsh-todo",
  "version": "0.1.0",
  "description": "Event-backed todo reminders and context restoration for DeepSeek Harness.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/integration.js",
    "check": "node --check index.js && node --check src/projection.js && node --check src/render.js && npm test"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.1-rc.2 || ^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "license": "MIT"
}
